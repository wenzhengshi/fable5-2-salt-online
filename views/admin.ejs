<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title><%= t(view === 'moderation' ? 'admin.modTitle' : view === 'signs' ? 'admin.signsTitle' : view === 'password' ? 'admin.passwordTitle' : view === 'login' ? 'admin.loginTitle' : 'admin.backupTitle') %> · <%= t('nav.title') %></title>
  <link rel="stylesheet" href="/css/admin-backup.css?v=4">
</head>
<body>
  <main>
    <header>
      <a href="/"><%= t('nav.title') %></a>
      <div class="admin-tools">
        <form action="/api/lang" method="post" class="lang-switch" aria-label="<%= t('nav.language') %>">
          <input name="redirect" type="hidden" value="<%= returnTo || '/admin' %>">
          <button type="submit" name="lang" value="zh-CN" class="<%= lang === 'zh-CN' ? 'active' : '' %>" aria-pressed="<%= lang === 'zh-CN' %>"><%= t('lang.zh') %></button>
          <button type="submit" name="lang" value="en-US" class="<%= lang === 'en-US' ? 'active' : '' %>" aria-pressed="<%= lang === 'en-US' %>"><%= t('lang.en') %></button>
        </form>
        <% if (csrf) { %>
          <form action="/admin/logout" method="post">
            <input name="csrf" type="hidden" value="<%= csrf %>">
            <button type="submit" class="plain"><%= t('admin.logout') %></button>
          </form>
        <% } %>
      </div>
    </header>
    <section aria-labelledby="title">
      <h1 id="title"><%= t(view === 'moderation' ? 'admin.modTitle' : view === 'signs' ? 'admin.signsTitle' : view === 'password' ? 'admin.passwordTitle' : view === 'login' ? 'admin.loginTitle' : 'admin.backupTitle') %></h1>
      <% if (message) { %><p class="<%= view === 'signs' || view === 'moderation' ? 'caption' : 'error' %>" role="status"><%= message %></p><% } %>
      <% if (view === 'backup') { %>
        <p><%= t('admin.backupIntro') %></p>
        <ul>
          <li><%= t('admin.backupSigns') %></li>
          <li><%= t('admin.backupScores') %></li>
          <li><%= t('admin.backupFocus') %></li>
        </ul>
        <form action="/admin/backup" method="post">
          <input name="csrf" type="hidden" value="<%= csrf %>">
          <button type="submit" class="primary"><%= t('admin.backupGenerate') %></button>
        </form>
        <p class="caption"><%= t('admin.backupNote') %></p>
        <nav class="admin-links" aria-label="<%= t('admin.linksLabel') %>"><a href="/admin/signs"><%= t('admin.signsTitle') %></a><a href="/admin/moderation"><%= t('admin.modTitle') %></a><a href="/admin/password"><%= t('admin.changePassword') %></a></nav>
      <% } else if (view === 'signs') { %>
        <p><%= t('admin.signsIntro') %></p>
        <p><a href="/admin"><%= t('admin.backToBackup') %></a></p>
        <% if (!result.total) { %><p><%= t('admin.signsEmpty') %></p><% } %>
        <% for (const sign of result.rows) { %>
          <article class="review-sign">
            <strong><%= sign.text %></strong>
            <p class="caption"><%= mapNames[sign.map] %> · X <%= sign.pos.x %> · Z <%= sign.pos.z %></p>
            <% if (sign.flaggedAt) { %>
              <p class="caption"><%= t('admin.signFlagged') %></p>
            <% } else { %>
              <form action="/admin/signs/<%= sign.id %>/flag" method="post">
                <input name="csrf" type="hidden" value="<%= csrf %>">
                <input name="page" type="hidden" value="<%= result.page %>">
                <button class="plain" type="submit"><%= t('admin.signFlag') %></button>
              </form>
            <% } %>
          </article>
        <% } %>
        <% if (result.pages > 1) { %>
          <nav class="admin-links" aria-label="<%= t('admin.paginationLabel') %>">
            <% if (result.page > 1) { %><a href="?page=<%= result.page - 1 %>"><%= t('admin.previous') %></a><% } %>
            <span><%= result.page %> / <%= result.pages %></span>
            <% if (result.page < result.pages) { %><a href="?page=<%= result.page + 1 %>"><%= t('admin.next') %></a><% } %>
          </nav>
        <% } %>
      <% } else if (view === 'moderation') { %>
        <p><%= t('admin.modIntro') %></p>
        <p><a href="/admin"><%= t('admin.backToBackup') %></a></p>
        <% const banForm = row => { %>
          <% if (row.canBan) { %>
            <details>
              <summary><%= t('admin.modBan') %></summary>
              <form class="login" action="/admin/moderation/ban/<%= row.token %>" method="post">
                <input name="csrf" type="hidden" value="<%= csrf %>">
                <label><%= t('admin.modDuration') %>
                  <select name="duration" required>
                    <option value="day"><%= t('admin.modDay') %></option>
                    <option value="week"><%= t('admin.modWeek') %></option>
                    <option value="permanent"><%= t('admin.modPermanent') %></option>
                  </select>
                </label>
                <label><%= t('admin.modReason') %>
                  <input name="reason" maxlength="120" required>
                </label>
                <button class="plain" type="submit"><%= t('admin.modConfirm') %></button>
              </form>
            </details>
          <% } %>
        <% }; %>
        <h2><%= t('admin.modSignals') %> (<%= report.incidents.length %>)</h2>
        <% if (!report.incidents.length) { %><p class="caption"><%= t('admin.modEmpty') %></p><% } %>
        <% for (const row of report.incidents) { %>
          <article class="review-sign">
            <strong><%= row.name %> · <%= row.id %></strong>
            <p class="caption"><%= row.map %> · <%= t('admin.modTypes.' + row.kind) %> × <%= row.count %> · <%= formatTime(row.lastAt) %></p>
            <% banForm(row); %>
          </article>
        <% } %>
        <h2><%= t('admin.modOnline') %> (<%= report.online.length %>)</h2>
        <% for (const row of report.online) { %>
          <article class="review-sign">
            <strong><%= row.name %> · <%= row.id %></strong>
            <p class="caption"><%= row.map %> · <%= row.kills %> / <%= row.deaths %></p>
            <% if (row.sameIp || row.sameFingerprint || row.samePair) { %>
              <p class="caption"><%= t('admin.modSameIp') %> <%= row.sameIp %> · <%= t('admin.modSameFingerprint') %> <%= row.sameFingerprint %> · <%= t('admin.modSamePair') %> <%= row.samePair %></p>
            <% } %>
            <% if (!row.canBan) { %><p class="caption"><%= t('admin.modNoIdentity') %></p><% } %>
            <% banForm(row); %>
            <form action="/admin/moderation/kick/<%= row.token %>" method="post">
              <input name="csrf" type="hidden" value="<%= csrf %>">
              <button class="plain" type="submit"><%= t('admin.modKick') %></button>
            </form>
          </article>
        <% } %>
        <h2><%= t('admin.modActive') %> (<%= report.bans.length %>)</h2>
        <% for (const ban of report.bans) { %>
          <article class="review-sign">
            <strong><%= ban.name %></strong>
            <p><%= ban.automatic ? t('admin.modAuto') + ' · ' + t('admin.modTypes.' + ban.reason) : ban.reason %></p>
            <p class="caption"><%= formatTime(ban.at) %> → <%= ban.until ? formatTime(ban.until) : t('admin.modPermanent') %></p>
            <form action="/admin/moderation/revoke/<%= ban.id %>" method="post">
              <input name="csrf" type="hidden" value="<%= csrf %>">
              <button class="plain" type="submit"><%= t('admin.modUnban') %></button>
            </form>
          </article>
        <% } %>
      <% } else if (view === 'password') { %>
        <p><%= t(firstLogin ? 'admin.firstLogin' : 'admin.passwordIntro') %></p>
        <form action="/admin/password" method="post" class="login">
          <input name="csrf" type="hidden" value="<%= csrf %>">
          <label for="current"><%= t('admin.currentPassword') %></label>
          <input id="current" name="current" type="password" autocomplete="current-password" required>
          <label for="new-password"><%= t('admin.newPassword') %></label>
          <input id="new-password" name="password" type="password" autocomplete="new-password" minlength="12" required>
          <label for="confirm"><%= t('admin.confirmPassword') %></label>
          <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" required>
          <button type="submit" class="primary"><%= t('admin.savePassword') %></button>
        </form>
      <% } else { %>
        <p><%= t('admin.loginIntro') %></p>
        <form action="/admin/login" method="post" class="login">
          <label for="username"><%= t('admin.username') %></label>
          <input id="username" name="username" value="admin" autocomplete="username" required>
          <label for="password"><%= t('admin.password') %></label>
          <input id="password" name="password" type="password" autocomplete="current-password" required autofocus>
          <button type="submit" class="primary"><%= t('admin.login') %></button>
        </form>
      <% } %>
    </section>
  </main>
</body>
</html>
